  "info": {
    "description": "Provides endpoints for marshaling data regrading items of trash logged in bins around Christchurch by the community. ",
    "version": "1.0.0",
    "title": "TrashApp API",
    "termsOfService": "https://trashapp.maxtyson.net/terms/",
    "contact": {
      "email": "mty24@uclive.ac.nz",
      "name": "Max Tyson",
      "url": "https://trashapp.maxtyson.net/"
    }
  },
  "tags": [
    {
      "name": "bin",
      "description": "Endpoints for searching, and managing community waste bins"
    },
    {
      "name": "user",
      "description": "Endpoints for searching, and managing community users of the app"
    },
    {
      "name": "report",
      "description": "Endpoints for creating, searching, and managing status reports of bins"
    },
    {
      "name": "trash",
      "description": "Endpoints for creating, searching, and managing trash logs in bins"
    },
    {
      "name": "community",
      "description": "Endpoints for querying statistics about community trash logging activity"
    },
    {
      "name": "auth",
      "description": "Endpoints for managing user session and access"
    }
