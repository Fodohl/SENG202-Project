  "paths": {
    "/heartbeat": {
      "get": {
        "summary": "Check if the server at the endpoint is reachable",
        "description": "",
        "parameters": [],
        "operationId": "heartbeat",
        "responses": {
          "200": {
            "description": "Server running",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "health": {
                      "type": "string"
                    },
                    "env" : {
                      "type": "string"
                    },
                    "motd": {
                      "type": "string"
                    }
                  }
                }
              }
            }
          }
        },
        "security": []
      }
    },
    "/bins": {
      "get": {
        "summary": "Get the bins available in the database",
        "description": "",
        "parameters": [
          {
            "name": "limit",
            "in": "query",
            "required": false,
            "schema": {
              "type": "string",
              "default": "50"
            },
            "allowEmptyValue": true,
            "description": "How many bins to fetch"
          },
          {
            "name": "page",
            "in": "query",
            "required": false,
            "schema": {
              "type": "string"
            },
            "description": "What page to get (ordered by id)",
            "allowEmptyValue": true
          }
        ],
        "operationId": "getBins",
        "responses": {
          "200": {
            "description": "List of bins",
            "content": {
              "application/json": {
                "schema": {}
              }
            }
          },
          "400": {
            "description": "Invalid paramater value",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "404": {
            "description": "No bins found for specified parameters",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          }
        },
        "tags": [
          "bin"
        ]
      }
    },
    "/bins/fullness": {
      "get": {
        "tags": [
          "bin"
        ],
        "operationId": "getBinsFullness",
        "responses": {
          "200": {
            "description": "ok",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "bins": {
                      "type": "array",
                      "items": {
                        "type": "object",
                        "properties": {
                          "id": {
                            "type": "integer",
                            "format": "int64"
                          },
                          "fullness": {
                            "type": "number"
                          }
                        }
                      }
                    }
                  }
                }
              }
            }
          },
          "400": {
            "description": "bad request",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "404": {
            "description": "not found",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          }
        }
      }
    },
